# Folder to index, mounted read-only.
ARIADNE_SOURCE_HOST_PATH=/path/to/markdown

# Required: the container listens on 0.0.0.0, so Ariadne refuses to start without a token.
# Generate with: openssl rand -hex 32
ARIADNE_TOKEN=

# Optional embeddings from any OpenAI-compatible /v1/embeddings endpoint. Leave both empty for
# keyword-only search.
ARIADNE_EMBED_URL=
ARIADNE_EMBED_MODEL=

# Optional reranker (llama.cpp /v1/rerank). Leave both empty to disable.
ARIADNE_RERANK_URL=
ARIADNE_RERANK_MODEL=

# Optional contextual chunks: an OpenAI-compatible chat endpoint writes a short context for each
# chunk at index time. Contexts are cached, so only new or edited sections cost a model call.
# Leave both empty to disable.
ARIADNE_CONTEXT_URL=
ARIADNE_CONTEXT_MODEL=
ARIADNE_CONTEXT_WORKERS=4

# Bearer token for the embedding, rerank, and context endpoints, if they need one.
ARIADNE_UPSTREAM_KEY=

# Folder to index, mounted read-only.
ARIADNE_SOURCE_HOST_PATH=/path/to/markdown

# Required: the container listens on 0.0.0.0, so Ariadne refuses to start without a token.
# Generate with: openssl rand -hex 32
ARIADNE_TOKEN=

# Optional embeddings from any OpenAI-compatible /v1/embeddings endpoint. Leave both empty for
# keyword-only search.
ARIADNE_EMBED_URL=
ARIADNE_EMBED_MODEL=

# Optional reranker (llama.cpp /v1/rerank). Leave both empty to disable.
ARIADNE_RERANK_URL=
ARIADNE_RERANK_MODEL=

# Bearer token for the embedding and rerank endpoints, if they need one.
ARIADNE_UPSTREAM_KEY=
